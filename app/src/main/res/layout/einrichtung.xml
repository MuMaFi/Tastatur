<?xml version="1.0" encoding="utf-8"?>
<!-- Drei Schritte, danach ein Feld zum Ausprobieren. Mehr braucht die
     Einrichtung nicht — alles Weitere macht die Tastatur selbst. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/einrichtung_titel"
        android:textColor="@color/schrift"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:text="@string/einrichtung_unter"
        android:textColor="@color/schrift_neben"
        android:textSize="15sp"/>

    <!-- Schritt 1 -->
    <LinearLayout style="@style/Karte">
      <TextView style="@style/KarteTitel" android:text="@string/schritt_1_titel"/>
      <TextView style="@style/KarteText" android:text="@string/schritt_1_text"/>
      <Button
          android:id="@+id/knopf_einstellungen"
          style="@style/Knopf"
          android:text="@string/schritt_1_knopf"/>
    </LinearLayout>

    <!-- Schritt 2 -->
    <LinearLayout style="@style/Karte">
      <TextView style="@style/KarteTitel" android:text="@string/schritt_2_titel"/>
      <TextView style="@style/KarteText" android:text="@string/schritt_2_text"/>
      <Button
          android:id="@+id/knopf_auswahl"
          style="@style/Knopf"
          android:text="@string/schritt_2_knopf"/>
    </LinearLayout>

    <!-- Schritt 3 -->
    <LinearLayout style="@style/Karte">
      <TextView style="@style/KarteTitel" android:text="@string/schritt_3_titel"/>
      <TextView style="@style/KarteText" android:text="@string/schritt_3_text"/>
      <Button
          android:id="@+id/knopf_mikrofon"
          style="@style/Knopf"
          android:text="@string/schritt_3_knopf"/>
    </LinearLayout>

    <!-- Probe -->
    <LinearLayout style="@style/Karte">
      <TextView style="@style/KarteTitel" android:text="@string/probe_titel"/>
      <EditText
          android:id="@+id/probe"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:background="@drawable/feld"
          android:hint="@string/probe_hinweis"
          android:inputType="textMultiLine|textCapSentences"
          android:minLines="3"
          android:gravity="top"
          android:padding="14dp"
          android:textColor="@color/schrift"
          android:textColorHint="@color/schrift_neben"
          android:textSize="16sp"/>
    </LinearLayout>

  </LinearLayout>
</ScrollView>
