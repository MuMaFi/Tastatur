<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Karte">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">vertical</item>
    <item name="android:background">@drawable/karte</item>
    <item name="android:padding">18dp</item>
    <item name="android:layout_marginBottom">14dp</item>
    <item name="android:elevation">2dp</item>
  </style>

  <style name="KarteTitel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/schrift</item>
    <item name="android:textSize">17sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="KarteText">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">6dp</item>
    <item name="android:textColor">@color/schrift_neben</item>
    <item name="android:textSize">14.5sp</item>
    <item name="android:lineSpacingMultiplier">1.15</item>
  </style>

  <style name="Knopf">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">14dp</item>
    <item name="android:background">@drawable/knopf</item>
    <item name="android:textColor">#FFFFFF</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:paddingLeft">20dp</item>
    <item name="android:paddingRight">20dp</item>
    <item name="android:minHeight">44dp</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
</resources>
